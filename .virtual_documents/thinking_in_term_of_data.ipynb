import json


#load the data 
def load_data(filename):
    with open (filename, "r")as f:
        data = json.load(f)
    return data


data = load_data("store_data.json")
print(data)
print(type(data))


def clean_data(data):
    text_to_num = {"one":1, "two":2, "three":3, "four":4, "five":5}
    cleaned_data = []
    unique_users = set()

    for user in data:
        # clean rating
        raw_rating = user["rating"].strip().lower()
        if raw_rating in text_to_num:
            raw_rating = text_to_num[raw_rating]
        user["rating"] = raw_rating

        # handle missing value
        if user.get("age") is None:
            user["age"] = None   # ya koi default value

        # deduplication
        name = user["name"].strip()
        if name in unique_users:
            continue
        unique_users.add(name)

        cleaned_data.append(user)
    return cleaned_data
        



data = clean_data(data)


#get meaningfull insight from data
def get_insight(data):
    #avg ratinh
    tot_rating = 0 
    for user in data:
        tot_rating+= float(user["rating"])
    print(f"avg rating = {tot_rating/len(data)}")

    #percentage

    poor_ratings = 0
    for user in data:
        if(float(user["rating"]) < 3):
            poor_ratings += 1
            
    print(f"% of user with poor rating = {poor_ratings/len(data) * 100}%")
    


get_insight(data)


def get_recommendations(data):
    recommendations = []

    for user in data:
        curr_recom = {}
        curr_recom["name"] = user["name"]

        if float(user["rating"]) >= 4:
            curr_recom["brand"] = "Apple"
        else:
            curr_recom["brand"] = "Samsung"
        recommendations.append(curr_recom)
    return recommendations






